<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mapFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.map.MapFragment"
        android:label="Map">
        <argument
            android:name="toponym"
            app:argType="com.ferrarieugenio.toponomastica_stenico_app.data.model.Toponym"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/action_mapFragment_to_detailFragment"
            app:destination="@id/detailFragment" />

        <action
            android:id="@+id/action_mapFragment_to_satelliteDataFragment"
            app:destination="@id/satelliteDataFragment" />

        <action
            android:id="@+id/action_mapFragment_self"
            app:destination="@id/mapFragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.search.SearchFragment"
        android:label="Search">
        <action
            android:id="@+id/action_searchFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.settings.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settingsFragment_to_satelliteDataFragment"
            app:destination="@+id/satelliteDataFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_appInfoFragment"
            app:destination="@+id/appInfoFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.detail.DetailFragment"
        android:label="Detail">
        <argument
            android:name="toponym"
            app:argType="com.ferrarieugenio.toponomastica_stenico_app.data.model.Toponym" />
        <action
            android:id="@+id/action_detailFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_detailFragment_self"
            app:destination="@id/detailFragment" />
    </fragment>

    <fragment
        android:id="@+id/satelliteDataFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.settings.satellitedata.SatelliteDataFragment"
        android:label="Satellite Data" />

    <fragment
        android:id="@+id/appInfoFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.settings.info.AppInfoFragment"
        android:label="App Info" />

    <fragment
        android:id="@+id/bookmarksFragment"
        android:name="com.ferrarieugenio.toponomastica_stenico_app.ui.main.bookmarks.BookmarksFragment"
        android:label="Bookmarks">
        <action
            android:id="@+id/action_bookmarksFragment_to_detailFragment"
            app:destination="@id/detailFragment" />
    </fragment>
</navigation>
