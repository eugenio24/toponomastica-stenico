<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top app bar with back button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardElevation="6dp"
        app:cardCornerRadius="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            android:elevation="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:title="Toponimo"
            android:titleTextColor="?attr/colorOnSurface"
            app:titleCentered="true"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:popupTheme="@style/ThemeOverlay.Material3.Light" />
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="16dp"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Descrizione -->
            <TextView
                android:id="@+id/descrizioneTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Descrizione"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: Forma ufficiale -->
            <TextView
                android:id="@+id/formaUfficialeLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Forma ufficiale:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/descrizioneTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Forma Ufficiale -->
            <TextView
                android:id="@+id/formaUfficialeTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Forma ufficiale"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/formaUfficialeLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: Quota -->
            <TextView
                android:id="@+id/quotaLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Quota:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/formaUfficialeTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Quota -->
            <TextView
                android:id="@+id/quotaTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Quota"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/quotaLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: Lat/Lon -->
            <TextView
                android:id="@+id/latlonLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Latitudine/Longitudine:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/quotaTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Lat/Lon -->
            <TextView
                android:id="@+id/latlonTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Lat/Lon"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/latlonLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/viewOnMapButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Visualizza sulla Mappa"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/latlonTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Label: Tags -->
            <TextView
                android:id="@+id/tagsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Tags:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/viewOnMapButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Tags -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/tagsChipGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:chipSpacing="8dp"
                app:layout_constraintTop_toBottomOf="@id/tagsLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: Cluster -->
            <TextView
                android:id="@+id/clusterLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sezione:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/tagsChipGroup"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Cluster -->
            <TextView
                android:id="@+id/clusterTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Cluster"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/clusterLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: HC Cluster -->
            <TextView
                android:id="@+id/hcClusterLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Zona:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/clusterTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- HC Cluster -->
            <TextView
                android:id="@+id/hcClusterTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="HC Cluster"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/hcClusterLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: Varianti -->
            <TextView
                android:id="@+id/variantiLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Varianti:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/hcClusterTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Varianti -->
            <TextView
                android:id="@+id/variantiTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Varianti"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/variantiLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Label: Vicini -->
            <TextView
                android:id="@+id/neighborsLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Toponimi nelle vicinanze:"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toBottomOf="@id/variantiTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Neighbors RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/neighborsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/neighborsLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
