<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:paddingHorizontal="0dp"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Bookmark name -->
    <TextView
        android:id="@+id/bookmarkName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Toponym Name"
        android:textSize="18sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/detailButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Detail icon button -->
    <ImageButton
        android:id="@+id/detailButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Dettagli"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_info"
        app:tint="?attr/colorPrimary"
        app:layout_constraintEnd_toStartOf="@id/removeButton"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Remove bookmark icon button -->
    <ImageButton
        android:id="@+id/removeButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Rimuovi"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_bookmark_remove"
        app:tint="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
