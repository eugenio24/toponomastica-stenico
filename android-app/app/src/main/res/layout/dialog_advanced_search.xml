<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top bar with dismiss/close button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filtri"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_centerVertical="true"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Annulla"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textAllCaps="false" />
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.12"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?android:attr/dividerHorizontal"
            android:showDividers="middle"
            android:dividerPadding="8dp">

            <!-- Quota Range -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quota"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/quotaRangeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="3500"
                android:stepSize="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Min Quota">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/minQuotaEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4" />
                </com.google.android.material.textfield.TextInputLayout>

                <Space
                    android:layout_width="16dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Max Quota">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/maxQuotaEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Tag selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tag selezionati"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginTop="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/selectedTagsChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleLine="false"
                app:chipSpacing="8dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/noTagsHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nessun tag selezionato – verranno mostrati tutti"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/black"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectTagsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleziona tag"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="8dp" />

            <!-- Cluster selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cluster selezionati"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/noClusterHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nessun cluster selezionato – verranno mostrati tutti"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/black"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/selectedClustersChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleLine="false"
                app:chipSpacing="8dp"
                android:visibility="gone"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectClustersButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleziona cluster"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="8dp" />

            <!-- HC Cluster selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HC Cluster selezionati"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:layout_marginTop="16dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/selectedHcClustersChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleLine="false"
                app:chipSpacing="8dp"
                android:visibility="gone"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/noHcClusterHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nessun hc cluster selezionato – verranno mostrati tutti"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/black"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectHcClustersButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seleziona HC cluster"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom button bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeAllFiltersButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rimuovi filtri"
            android:backgroundTint="?attr/colorSurface"
            android:textColor="?attr/colorPrimary" />

        <Space android:layout_width="16dp" android:layout_height="wrap_content"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Applica" />
    </LinearLayout>

</LinearLayout>
