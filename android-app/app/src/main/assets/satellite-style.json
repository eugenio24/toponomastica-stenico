{
  "version": 8,
  "sources": {
    "offline-raster-source": {
      "type": "raster",
      "tiles": [
        "___SATELLITE_FOLDER_URI___"
      ],
      "tileSize": 256,
      "minzoom": 12,
      "maxzoom": 17
    },
    "contours": {
      "type": "vector",
      "url": "___CONTOURS_FILE_URI___"
    },
    "municipalities": {
      "type": "vector",
      "url": "___MUNICIPALITIES_FILE_URI___"
    }
  },
  "sprite": "asset://sprites/sprite",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "offline-raster-layer",
      "type": "raster",
      "source": "offline-raster-source",
      "minzoom": 12,
      "maxzoom": 17
    },
    {
      "id": "contour_label",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contours",
      "filter": [
        "all",
        ["==", "$type", "LineString"],
        [">", "ELEV", 0]
      ],
      "layout": {
        "symbol-avoid-edges": true,
        "symbol-placement": "line",
        "text-field": "{ELEV} m",
        "text-font": ["Noto Sans Bold"],
        "text-size": {"base": 1, "stops": [[15, 9.5], [20, 12]]},
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "hsl(0, 0%, 37%)",
        "text-halo-color": "hsla(0, 0%, 100%, 0.5)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "contour",
      "type": "line",
      "source": "contours",
      "source-layer": "contours",
      "filter": [">", "ELEV", 0],
      "paint": {
        "line-color": "hsl(0, 1%, 58%)",
        "line-opacity": 0.4,
        "line-width": 1
      }
    },
    {
      "id": "municipality-boundary",
      "type": "line",
      "source": "municipalities",
      "source-layer": "municipalities",
      "filter": ["==", "admin_level", "8"],
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": "#FF6600",
        "line-width": 2,
        "line-opacity": 0.8
      }
    },
    {
      "id": "municipality-label",
      "type": "symbol",
      "source": "municipalities",
      "source-layer": "municipalities",
      "filter": ["==", "admin_level", "8"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10, 10,
          15, 16
        ],
        "text-anchor": "center",
        "text-offset": [0, 0.5],
        "text-max-angle": 30,
        "text-letter-spacing": 0.1,
        "text-radial-offset": 0.3,
        "text-allow-overlap": false,
        "text-ignore-placement": false
      },
      "paint": {
        "text-color": "#FF6600",
        "text-halo-color": "rgba(255, 255, 255, 0.9)",
        "text-halo-width": 2,
        "text-opacity": 1
      }
    }
  ]
}
